{
  "name": "rt-research-flow",
  "version": "0.1.0-beta.2",
  "description": "RT-ResearchFlow - 本地优先的 A 股个人投研工作台",
  "main": "./out/main/index.js",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.0.0 <21",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "vite build --config research-access.vite.config.ts && electron-vite dev",
    "build": "electron-vite build && vite build --config research-access.vite.config.ts && node scripts/report-build-sizes.mjs",
    "report:size": "node scripts/report-build-sizes.mjs",
    "measure:startup": "node scripts/measure-cold-start.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --config electron-builder.js",
    "dist:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config electron-builder.js",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit --pretty false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.7.2",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.0.0",
    "dompurify": "^3.1.6",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "electron-store": "^8.2.0",
    "lightweight-charts": "^5.1.0",
    "mermaid": "^11.14.0",
    "openai": "^6.32.0",
    "pdf-parse": "2.4.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.45.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cheerio": "^0.22.35",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "postcss": "^8.4.40",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.4",
    "vitest": "^2.0.4"
  }
}
